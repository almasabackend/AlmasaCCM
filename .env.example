PORT=3000
NODE_ENV=production

# Set this on Hostinger. If empty, the app uses a temporary in-memory demo store.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Login users. Set separate passwords in Hostinger environment variables.
UDARAKA_PASSWORD=change-this-udaraka-password
SHUAIB_PASSWORD=change-this-shuaib-password
SESSION_SECRET=change-this-random-secret
