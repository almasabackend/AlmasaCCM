<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Almasa Campaign Contact Management</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/app.js" defer></script>
  </head>
  <body>
    <aside class="sidebar">
      <div class="brand">
        <img class="brand-logo" src="/assets/almasa-logo.svg" alt="Almasa">
        <div>
          <strong>Almasa Campaign Contact Management</strong>
          <small><%= storeKind === "mysql" ? "Hostinger SQL" : storeKind.includes("error") ? "Diagnostics mode" : "Local demo memory" %></small>
        </div>
      </div>

      <% if (typeof currentCountry !== "undefined") { %>
        <div class="country-tabs">
          <% countries.forEach((country) => { %>
            <a class="<%= currentCountry.code === country.code ? "active" : "" %>" href="/<%= country.code %>/dashboard"><span class="flag"><%= country.flag %></span><%= country.name %></a>
          <% }) %>
        </div>

        <nav class="nav">
          <a href="/<%= currentCountry.code %>/dashboard"><span class="flag"><%= currentCountry.flag %></span>Dashboard</a>
          <details class="nav-group" <%= path.includes("/contacts") ? "open" : "" %>>
            <summary>Contacts</summary>
            <a href="/<%= currentCountry.code %>/contacts">View all</a>
            <a href="/<%= currentCountry.code %>/contacts?status=subscribed">Subscribed</a>
            <a href="/<%= currentCountry.code %>/contacts?status=unsubscribed">Unsubscribed</a>
            <a href="/<%= currentCountry.code %>/contacts?status=blocked">Blocked</a>
            <a href="/<%= currentCountry.code %>/contacts?status=invalid">Invalid</a>
            <a href="/<%= currentCountry.code %>/contacts?missingCompany=1">Missing company</a>
            <a href="/<%= currentCountry.code %>/contacts?missingName=1">Missing person</a>
            <% if (typeof contactGroups !== "undefined" && contactGroups.length) { %>
              <span class="nav-label">Groups</span>
              <% contactGroups.forEach((group) => { %>
                <a href="/<%= currentCountry.code %>/contacts?group=<%= group.id %>"><%= group.name %> <small><%= group.contact_count %></small></a>
              <% }) %>
            <% } %>
          </details>
          <% if (!currentCountry.combined) { %>
            <a href="/<%= currentCountry.code %>/import">Import</a>
            <a href="/<%= currentCountry.code %>/filter">Filter My List</a>
          <% } else { %>
            <a href="/AE/import">Import</a>
            <a href="/AE/filter">Filter My List</a>
          <% } %>
          <a href="/<%= currentCountry.code %>/export">Export</a>
          <a href="/<%= currentCountry.code %>/history">Upload History</a>
          <a href="/<%= currentCountry.code %>/settings">Settings</a>
          <a href="/diagnostics">Diagnostics</a>
        </nav>
      <% } %>

      <% if (adminEnabled) { %>
        <form action="/logout" method="post" class="logout">
          <% if (currentUser) { %>
            <small class="signed-in">Signed in as <%= currentUser.name %></small>
          <% } %>
          <button type="submit">Log out</button>
        </form>
      <% } %>
    </aside>
    <main class="main">
