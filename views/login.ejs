<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - Almasa Campaign Contact Management</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="login-page">
    <main class="login-panel">
      <img class="login-logo" src="/assets/almasa-logo.svg" alt="Almasa">
      <p>Sign in to manage contacts.</p>
      <% if (error) { %><div class="alert danger"><%= error %></div><% } %>
      <form method="post" action="/login">
        <label>Email</label>
        <input type="email" name="email" value="<%= email || "" %>" autocomplete="email" required autofocus>
        <label>Password</label>
        <input type="password" name="password" autocomplete="current-password" required>
        <button type="submit">Log in</button>
      </form>
    </main>
  </body>
</html>
