<%- include("partials/header") %>
  <header class="page-header">
    <div>
      <h1><span class="page-flag"><%= currentCountry.flag %></span>Import <%= currentCountry.name %> Contacts</h1>
      <p>Upload CSV/XLSX files. Rows that mention unsubscribe, opt out, stop, remove, or do not contact become suppressed.</p>
    </div>
  </header>

  <section class="panel">
    <form method="post" enctype="multipart/form-data" class="upload-form" data-upload-form data-progress-target="import-progress">
      <div class="form-grid">
        <label class="drop-zone">
          <input type="file" name="files" accept=".csv,.xlsx,.xlsm,.xltx,.xltm" multiple required>
          <span class="drop-title">Drop CSV/XLSX files here</span>
          <span class="drop-copy">or click to choose files</span>
          <span class="file-name">No file selected</span>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="updateExisting" value="1">
          Update existing contact details from imported file
        </label>
      </div>
      <button type="submit">Preview import</button>
    </form>
  </section>

  <section id="import-progress" class="panel progress-panel" hidden aria-live="polite">
    <div class="progress-header">
      <div>
        <h2>Uploading Contact File</h2>
        <p class="progress-message">Preparing upload.</p>
      </div>
      <strong class="progress-percent">0%</strong>
    </div>
    <div class="progress-track"><span class="progress-bar"></span></div>
    <div class="progress-steps">
      <span class="active">Upload</span>
      <span>Read sheets</span>
      <span>Check database</span>
      <span>Show results</span>
    </div>
  </section>

  <% if (result?.error) { %>
    <div class="alert danger"><%= result.error %></div>
  <% } %>

  <% if (preview?.summary) { %>
    <section class="panel confirm-panel">
      <div class="confirm-header">
        <div>
          <h2>Confirm database update</h2>
          <p class="muted">Nothing has been saved yet. Review these counts, then confirm only if this looks correct.</p>
        </div>
        <span class="status grey">Waiting for confirmation</span>
      </div>
      <div class="summary-grid">
        <span>Will be added <strong><%= preview.summary.preview_will_add %></strong></span>
        <span>Will be removed from active list <strong><%= preview.summary.preview_will_remove %></strong></span>
        <span>Will be updated <strong><%= preview.summary.preview_will_update %></strong></span>
        <span>Unchanged <strong><%= preview.summary.preview_unchanged %></strong></span>
        <span>Duplicated <strong><%= preview.summary.duplicates %></strong></span>
        <span>Invalid <strong><%= preview.summary.invalid_numbers %></strong></span>
        <span>Rows scanned <strong><%= preview.summary.total_rows %></strong></span>
        <span>Numbers found <strong><%= preview.summary.numbers_found %></strong></span>
      </div>
      <% if (preview.summary.imported_unsubscribed) { %>
        <div class="alert warning">This upload contains <strong><%= preview.summary.imported_unsubscribed %></strong> unsubscribe/suppression records. Confirming will mark those contacts as Unsubscribed in the main database.</div>
      <% } %>
      <div class="button-row result-actions">
        <form method="post" action="/<%= currentCountry.code %>/import/confirm/<%= preview.token %>">
          <button type="submit">Confirm and update database</button>
        </form>
        <a class="secondary-button" href="/<%= currentCountry.code %>/import">Cancel import</a>
      </div>
    </section>

    <section class="panel">
      <h2>Preview results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Country</th>
              <th>WhatsApp number</th>
              <th>Company</th>
              <th>Person</th>
              <th>Email</th>
              <th>Detected status</th>
              <th>Preview result</th>
            </tr>
          </thead>
          <tbody>
            <% preview.results.slice(0, 300).forEach((row) => { %>
              <tr>
                <td><%= row.country || currentCountry.code %></td>
                <td><%= row.phone_e164 || row.raw_phone %></td>
                <td><%= row.company_name %></td>
                <td><%= row.contact_name %></td>
                <td><%= row.email %></td>
                <td><%= row.detected_status %></td>
                <td><span class="status <%= row.result.toLowerCase().includes("unsub") || row.result.toLowerCase().includes("suppress") ? "red" : row.result.toLowerCase().includes("invalid") ? "grey" : "green" %>"><%= row.result %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (preview.results.length > 300) { %><p class="muted">Showing first 300 rows.</p><% } %>
    </section>
  <% } %>

  <% if (result?.summary) { %>
    <section class="success-card">
      <span class="success-check" aria-hidden="true">✓</span>
      <div>
        <h2>Upload confirmed</h2>
        <p>The main database was updated successfully.</p>
      </div>
    </section>

    <section class="panel">
      <h2>Import summary</h2>
      <% if (result.snapshot) { %>
        <div class="alert">Rollback snapshot created before this import: <strong><%= result.snapshot.label %></strong>.</div>
      <% } %>
      <div class="summary-grid">
        <span>Rows scanned <strong><%= result.summary.total_rows %></strong></span>
        <span>Numbers found <strong><%= result.summary.numbers_found %></strong></span>
        <span>New subscribed <strong><%= result.summary.new_added %></strong></span>
        <span>Existing <strong><%= result.summary.already_existing %></strong></span>
        <span>Updated <strong><%= result.summary.existing_updated %></strong></span>
        <span>Imported unsubscribed <strong><%= result.summary.imported_unsubscribed %></strong></span>
        <span>Kept suppressed <strong><%= result.summary.unsubscribed_blocked %></strong></span>
        <span>Duplicates <strong><%= result.summary.duplicates %></strong></span>
        <span>Invalid <strong><%= result.summary.invalid_numbers %></strong></span>
      </div>
    </section>

    <section class="panel">
      <h2>Import results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Country</th>
              <th>WhatsApp number</th>
              <th>Company</th>
              <th>Person</th>
              <th>Email</th>
              <th>Detected status</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            <% result.results.slice(0, 300).forEach((row) => { %>
              <tr>
                <td><%= row.country || currentCountry.code %></td>
                <td><%= row.phone_e164 || row.raw_phone %></td>
                <td><%= row.company_name %></td>
                <td><%= row.contact_name %></td>
                <td><%= row.email %></td>
                <td><%= row.detected_status %></td>
                <td><span class="status <%= row.result.toLowerCase().includes("unsub") || row.result.toLowerCase().includes("suppress") ? "red" : row.result.toLowerCase().includes("invalid") ? "grey" : "green" %>"><%= row.result %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (result.results.length > 300) { %><p class="muted">Showing first 300 rows.</p><% } %>
    </section>
  <% } %>
<%- include("partials/footer") %>
